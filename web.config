<?xml version="1.0" encoding="UTF-8"?>
<!-- MuDeskClient - https://miguelenred.es/mudeskclient - Apache License 2.0 -->
<!-- IIS: when the whole project is under the web site, only public/ may be served.
     Uses core request filtering only (no URL Rewrite module needed). Open the app at .../public/
     or point the site (or a virtual directory) to public/. data/, src/, tests/, tools/ and docs/
     also carry their own web.config that refuses every file; vendor/ (made by Composer) is hidden here. -->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="data" />
          <add segment="src" />
          <add segment="tests" />
          <add segment="tools" />
          <add segment="docs" />
          <add segment="vendor" />
          <add segment="config.php" />
          <add segment="config.sample.php" />
          <add segment="LICENSE" />
          <add segment="NOTICE" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
