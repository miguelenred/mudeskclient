<?xml version="1.0" encoding="UTF-8"?>
<!-- MuDeskClient - https://miguelenred.es/mudeskclient - Apache License 2.0 -->
<!-- IIS: serves the web app manifest (installing the app on phones and computers); IIS does not know the .webmanifest
     extension and answers 404 for unknown types. -->
<configuration>
  <!-- the page's scripts and styles revalidated on every load (ETag / 304): the modules app.js imports carry no version in
       their address, so after an update the browser must not mix cached old modules with new ones (as .htaccess for Apache) -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
