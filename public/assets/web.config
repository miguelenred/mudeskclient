<?xml version="1.0" encoding="UTF-8"?>
<!-- MuDeskClient - https://miguelenred.es/mudeskclient - Apache License 2.0 -->
<!-- IIS: scripts and styles are revalidated on every load (Cache-Control: no-cache, then ETag / 304): the modules that
     app.js imports carry no version in their address, so after an update old cached modules must not be mixed in. -->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
